# Discord Bot Environment Variables

# Discord Configuration
DISCORD_TOKEN=your_bot_token_here
DISCORD_APP_ID=your_application_id_here
BOT_OWNER_ID=your_discord_user_id  # REQUIRED for dashboard access

# Database (for Docker: use service names, for local: use localhost)
DATABASE_URL=postgresql://bot_user:password@localhost:5432/discord_bot
DATABASE_PASSWORD=changeme  # Used by Docker Compose for postgres container
REDIS_URL=redis://localhost:6379/0

# AI Providers (Optional - at least one if AI enabled)
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# Dashboard Security (REQUIRED for dashboard access)
DASHBOARD_SECRET_KEY=generate_with_python_secrets  # python -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_DISCORD_CLIENT_ID=your_discord_app_client_id
DASHBOARD_DISCORD_CLIENT_SECRET=your_discord_app_client_secret

# Dashboard Ports Configuration
# Change these to any random ports you want (1024-65535)
# Examples: 8192, 9876, 5432, 7890, etc.
DASHBOARD_FRONTEND_PORT=3000          # External port for web UI (what you access in browser)
DASHBOARD_BACKEND_PORT=8080            # External port for API backend
DASHBOARD_BACKEND_INTERNAL_PORT=8080   # Internal container port (usually keep at 8080)

# Dashboard URLs (update redirect_uri if you change frontend port)
DASHBOARD_DISCORD_REDIRECT_URI=http://localhost:3000/auth/callback  # Update if DASHBOARD_FRONTEND_PORT changes
DASHBOARD_API_URL=http://localhost:8080  # Update if DASHBOARD_BACKEND_PORT changes

# Dashboard Host (usually keep as 0.0.0.0 to accept connections from anywhere)
DASHBOARD_HOST=0.0.0.0

# Dashboard API Key (Optional - for programmatic access)
DASHBOARD_API_KEY=generate_with_python_secrets  # python -c "import secrets; print(secrets.token_urlsafe(32))"

# Optional: Lavalink for Music (if music feature enabled)
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass

# Environment
ENVIRONMENT=development  # development, production
